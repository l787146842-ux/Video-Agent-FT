{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "static/dist",
    "rootDir": "src/web",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/web/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx"],
  "exclude": ["node_modules", "static/dist"]
}
