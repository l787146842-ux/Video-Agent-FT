{
  "flow": {
    "steps": {
      "1": "起草 Final_Video_Spec.md（标题、类型、长宽比、时长、视觉风格、语言、模型偏好）",
      "2": "生成故事板脚本（关键元素、分镜头列表、音频层） → **storyboard_key_elements / storyboard_shots / storyboard_audio**。",
      "3": "为所有元素生成图像 → write_media_prompt、image_generate。",
      "4": "为每个镜头生成最终视频，参考关键元素图像",
      "5": "根据故事板脚本生成所有音频层 → **audio_generate**。",
      "6": "所有素材就绪后进行最终剪辑，引导用户导出"
    },
    "dependencies": {
      "2": [
        1
      ],
      "3": [
        2
      ],
      "4": [
        2,
        3
      ],
      "5": [
        2
      ],
      "6": [
        4,
        5
      ]
    },
    "step_stages": {
      "1": "spec",
      "2": "structure",
      "3": "ke_media",
      "4": "shot_media",
      "5": "audio_assets",
      "6": "assembly"
    },
    "spec_wizard": true,
    "spec_gate": true
  },
  "pause": {
    "stage_pause": true
  },
  "schema_version": 3,
  "pause_points": [
    {
      "id": "storyboard_structure_ready",
      "trigger": "storyboard_structure_ready"
    },
    {
      "id": "first_generation_call",
      "trigger": "first_generation_call"
    }
  ],
  "language": {
    "prompt": "en"
  }
}
