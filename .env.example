# .env.example
# 请将此文件复制为 .env 并填入实际变量

# Video Agent Configuration
ENVIRONMENT=development

# 安全认证（生产环境必须设置）
# ENVIRONMENT=production 时启用 API Key 校验，所有 /api/ 请求需携带 X-API-Key 头
# ENVIRONMENT=development 时跳过认证（默认）
API_KEY=

# 服务端口（避免与熊布画布 3000 冲突，本项目使用 8080）
PORT=8080

# LLM 调用参数（adapter 未显式传参时的全局回落值）
# LLM_TIMEOUT=120
# LLM_STREAM_TIMEOUT=180
# LLM_MAX_TOKENS=8192
# LLM_TEMPERATURE=0.7

# Token 治理（默认值即为推荐值，一般无需配置）
# 注入 LLM 的图片长边上限（px），vision 模型会重采样，原图内联纯浪费 token；0=不缩放
# LLM_IMAGE_MAX_EDGE=1024
# 记忆摘要专用模型（"provider:model"），空 = 走 fallback 链末位
# MEMORY_SUMMARY_MODEL=
# 工作台状态 JSON 紧凑序列化（false = indent=2 便于人工排查）
# CONTEXT_JSON_COMPACT=true
# 会话级 compaction：history 条数达该阈值时用便宜模型压缩较早对话（0=关闭；814G7 起默认 12 开启）
# HISTORY_COMPACT_THRESHOLD=12
# 主模型思考档位回落值（814H7 起主模型档位由对话栏「推理等级」按会话选择，默认=原生）；
# 本 env 仅影响未携带会话档位的残留调用。执行器/辅助摘要档位在「全局设置→推理档位」页配置。
# LLM_THINKING_LEVEL=
# AUX_THINKING_LEVEL=

# 状态持久化后端：sqlite（默认，事务原子性/并发安全）| json（回退）
# STATE_BACKEND=sqlite

# 日志文件落盘开关（六轮 S4）：服务进程默认 true；测试/验收进程
# （tests/conftest.py / scripts/acceptance.py）自动置 false，防多进程争用同一日志文件
# LOG_FILE_ENABLED=true

# 请求限流（每分钟每 IP，0 = 不限流）：聊天类与生成类分档，
# 生成类配额更高，避免批量生图/生视频误伤
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GENERATE_PER_MINUTE=60
# 是否信任 X-Forwarded-For 提取客户端 IP：仅在可信反向代理后置 true，
# 本机直连部署保持 false（该头可被伪造绕过 IP 级限流）
TRUST_PROXY=false

# CLI 协议（Antigravity CLI / gemini-cli 等）路由到 custom-api 反代时 auto 的回退模型：
# 聊天已走本机 agy CLI（对齐熊布），此值仅影响带参考图的生图编辑等残留反代路径；
# 若反代报 "model not register"，改成反代已注册的模型名后重启服务
# CLI_AUTO_CHAT_MODEL=gemini-3.1-flash-image

# 熊布画布服务地址（Agent 通过此地址操作画布）
CANVAS_BASE_URL=http://127.0.0.1:3000
CANVAS_TIMEOUT=30
CANVAS_ENABLED=true

# 熊布 Provider 配置共享（本地兜底 + 熊布增强）
# Agent 从熊布读取 provider 列表并合并，生图优先路由到熊布
CANVAS_PROVIDERS_URL=http://127.0.0.1:3000/api/providers
CANVAS_PROVIDERS_FILE=/path/to/canvas/data/api_providers.json
CANVAS_ENV_FILE=/path/to/canvas/API/.env
CANVAS_HEALTH_CACHE_SECONDS=30

# Agent 混合记忆系统
MEMORY_ENABLED=true
# 向量后端：chromadb（需 pip install chromadb，未安装自动降级 JSON 关键词检索）/ json
MEMORY_VECTOR_BACKEND=chromadb
MEMORY_MAX_RESULTS=5
# 每 N 轮对话触发一次摘要写入
MEMORY_SUMMARY_INTERVAL=10
# 记忆时间衰减半衰期（天）
MEMORY_TIME_DECAY_DAYS=30

# 示例：API Keys
# KLING_API_KEY=your_kling_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
SKILL_RUNTIME=auto
EXECUTOR_FAST_MODEL=
EXECUTOR_THINKING_LEVEL=
LLM_JSON_TIMEOUT=120
LLM_OUTPUT_LIMIT=8192
IMAGE_REF_LIMIT=10
IMAGE_GEN_CONCURRENCY=4
VIDEO_REF_LIMIT_IMAGE=30
VIDEO_REF_LIMIT_VIDEO=10
VIDEO_REF_LIMIT_AUDIO=10
VIDEO_REF_LIMIT_TOTAL=50
